CompileFlags:
  CompilationDatabase: .
Index:
  Background: Build
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
Completion:
  AllScopes: Yes

---
# Host-built unit tests use their own database, not the firmware cross build.
If:
  PathMatch: test/unit/.*
CompileFlags:
  CompilationDatabase: test/
